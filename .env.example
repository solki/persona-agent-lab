POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agent_swarm_lab
FRONTEND_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CREATE_TABLES_ON_STARTUP=true

# Qdrant is started by Docker Compose by default for local development.
# Local development Qdrant does not require an API key.
# Dashboard: http://localhost:6333/dashboard
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=agent_swarm_lab

TAVILY_API_KEY=

LLM_PROVIDER=mock

# Generic OpenAI-compatible provider
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_PROVIDER_NAME=

# Optional standard OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Anthropic provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
